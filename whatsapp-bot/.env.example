# ==========================================
# ECOLOOP WHATSAPP BOT - ENVIRONMENT CONFIG
# ==========================================

# Server Port & Public Base URL (Required for serving QR codes & PDF reports to WhatsApp)
PORT=5001
BASE_URL=https://ecoloop-bot.onrender.com

# Meta WhatsApp Cloud API Credentials
# Get these from: https://developers.facebook.com/apps -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_or_system_user_access_token_here
WHATSAPP_VERIFY_TOKEN=ecoloop_mission_verify_token_2026

# Optional: Meta App Secret (for X-Hub-Signature-256 payload integrity validation)
WHATSAPP_APP_SECRET=your_app_secret_optional

# Database: MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ecoloop_whatsapp?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ecoloop_whatsapp

# Optional: OpenAI API Key (used as fallback vision decoder for complex, angled photos of QR codes)
OPENAI_API_KEY=

# Institution / Campus Configuration
CAMPUS_NAME="NMAM Institute of Technology, Nitte"
DEFAULT_HOSTEL="Nandani"
SUPPORT_CONTACT="+91-9876543210"
CPCB_PORTAL_URL="https://eprewastecpcb.in"
